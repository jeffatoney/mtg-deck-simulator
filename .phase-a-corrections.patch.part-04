diff --git a/docs/audit/phase-a-golden-transcripts/transcripts/commit-removes-spell-copy-pending-action.json b/docs/audit/phase-a-golden-transcripts/transcripts/commit-removes-spell-copy-pending-action.json
new file mode 100644
index 0000000..729c1bd
--- /dev/null
+++ b/docs/audit/phase-a-golden-transcripts/transcripts/commit-removes-spell-copy-pending-action.json
@@ -0,0 +1,32 @@
+{
+  "schema_version": "phase-a-golden-transcript-v1",
+  "transcript_id": "commit-removes-spell-copy-pending-action",
+  "title": "Commit removes a spell copy and its pending action consistently",
+  "plain_english": [
+    "A real frozen-Oracle Opt spell and a synthetic copy of that spell are on the stack with separate action identities.",
+    "P0 casts the Commit face of the real frozen-Oracle Commit // Memory targeting the current spell-copy object.",
+    "After all players pass, Commit resolves and puts the targeted spell copy second from the top of the modeled library path before synthetic cessation processing.",
+    "The action that created the removed spell copy is removed from pending_actions at the same transition.",
+    "The original Opt spell and its action remain on the stack and pending until their own legal resolution or countering."
+  ],
+  "machine": {
+    "test_node": "tests/phase_a/test_kernel_acceptance.py::test_commit_clears_pending_action_for_removed_spell_copy",
+    "preconditions": [
+      "an Opt spell object is on the stack",
+      "a synthetic spell copy of Opt is above it on the stack",
+      "both stack objects have distinct pending action IDs",
+      "Commit // Memory is in P0 hand"
+    ],
+    "ordered_operations": [
+      "cast Commit targeting the spell-copy object",
+      "P0 pass_priority",
+      "P1 pass_priority"
+    ],
+    "required_assertions": [
+      "the targeted spell-copy action is absent from pending_actions",
+      "Commit's action is absent from pending_actions after resolution",
+      "the original Opt action remains pending",
+      "the targeted spell-copy object is no longer on the stack"
+    ]
+  }
+}
diff --git a/docs/audit/phase-a-golden-transcripts/transcripts/dualcaster-opt-spell-copy.json b/docs/audit/phase-a-golden-transcripts/transcripts/dualcaster-opt-spell-copy.json
new file mode 100644
index 0000000..1dd497b
--- /dev/null
+++ b/docs/audit/phase-a-golden-transcripts/transcripts/dualcaster-opt-spell-copy.json
@@ -0,0 +1,33 @@
+{
+  "schema_version": "phase-a-golden-transcript-v1",
+  "transcript_id": "dualcaster-opt-spell-copy",
+  "title": "Dualcaster Mage creates a real Opt spell copy without casting it",
+  "plain_english": [
+    "P0 casts the real frozen-Oracle Opt and leaves it on the stack.",
+    "P0 casts the real frozen-Oracle Dualcaster Mage while Opt remains a legal instant target.",
+    "After Dualcaster Mage resolves, its enters-the-battlefield trigger is put on the stack with Opt as the recorded target.",
+    "The trigger resolves and creates a synthetic spell-copy object with no physical-card component and was_cast set to false.",
+    "The copied Opt resolves through the same production stack path and then ceases to exist after its recorded zone arrival."
+  ],
+  "machine": {
+    "test_node": "tests/phase_a/test_kernel_acceptance.py::test_dualcaster_copy_and_twinflame_delayed_exile_are_real_objects",
+    "preconditions": [
+      "Opt is a spell object on the stack",
+      "Dualcaster Mage is a physical card in P0 hand",
+      "the trigger target choice records the current Opt object ID"
+    ],
+    "ordered_operations": [
+      "cast Opt",
+      "cast Dualcaster Mage",
+      "all players pass to resolve Dualcaster Mage",
+      "all players pass to resolve Dualcaster Mage ETB trigger",
+      "all players pass to resolve copied Opt"
+    ],
+    "required_assertions": [
+      "copy_kind is SPELL_COPY",
+      "component_card_instance_ids is empty",
+      "was_cast is false",
+      "the spell copy is retired and ceased_to_exist after resolution"
+    ]
+  }
+}
diff --git a/docs/audit/phase-a-golden-transcripts/transcripts/glint-horn-discard-trigger-order.json b/docs/audit/phase-a-golden-transcripts/transcripts/glint-horn-discard-trigger-order.json
new file mode 100644
index 0000000..54cea91
--- /dev/null
+++ b/docs/audit/phase-a-golden-transcripts/transcripts/glint-horn-discard-trigger-order.json
@@ -0,0 +1,42 @@
+{
+  "schema_version": "phase-a-golden-transcript-v1",
+  "transcript_id": "glint-horn-discard-trigger-order",
+  "title": "Glint-Horn Buccaneer discard trigger resolves above its draw ability",
+  "plain_english": [
+    "The real frozen-Oracle Glint-Horn Buccaneer is attacking under P0 control and P0 can legally pay one generic and one red mana.",
+    "P0 activates Glint-Horn Buccaneer's own attack-restricted ability and discards a card as an activation cost.",
+    "The discard-triggered damage ability is put on the stack above the activated draw ability.",
+    "After both players pass, the damage trigger resolves first and deals one damage to each opponent.",
+    "State-based actions occur only after the triggered ability has completely resolved; a lethal opponent loss is recorded after STACK_OBJECT_RESOLVED.",
+    "If the game remains active, a later all-player pass sequence resolves the activated draw ability."
+  ],
+  "machine": {
+    "test_node": "tests/phase_a/test_kernel_acceptance.py::test_lethal_damage_defers_state_based_actions_until_resolution_finishes",
+    "preconditions": [
+      "Glint-Horn Buccaneer is attacking",
+      "P0 has legal mana for {1}{R}",
+      "P0 has an explicit card to discard",
+      "P1 has one life for the lethal-ordering case"
+    ],
+    "ordered_operations": [
+      "activate glint-horn:attack-loot",
+      "pay {1}{R}",
+      "discard the selected card as a cost",
+      "put discard trigger above activated ability",
+      "P0 pass_priority",
+      "P1 pass_priority"
+    ],
+    "required_event_order": [
+      "CARD_DISCARDED",
+      "TRIGGER_PUT_ON_STACK",
+      "DAMAGE_DEALT",
+      "STACK_OBJECT_RESOLVED",
+      "GAME_TERMINATED"
+    ],
+    "required_assertions": [
+      "STACK_OBJECT_RESOLVED precedes GAME_TERMINATED",
+      "no resolution or cessation event occurs after GAME_TERMINATED",
+      "P1 loses for LIFE_TOTAL"
+    ]
+  }
+}
diff --git a/docs/audit/phase-a-golden-transcripts/transcripts/priority-gated-sol-ring-resolution.json b/docs/audit/phase-a-golden-transcripts/transcripts/priority-gated-sol-ring-resolution.json
