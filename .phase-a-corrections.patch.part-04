@@ -0,0 +1,33 @@
+{
+  "schema_version": "phase-a-golden-transcript-v1",
+  "transcript_id": "priority-gated-sol-ring-resolution",
+  "title": "Sol Ring resolves only after the complete priority-pass sequence",
+  "plain_english": [
+    "P0 casts the real frozen-Oracle Sol Ring from hand while holding priority.",
+    "The spell remains on the stack 