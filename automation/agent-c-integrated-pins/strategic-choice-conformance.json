  "source_invariants": [
    {"name": "production exports trigger-aware provider", "path": "src/mtg_policy/__init__.py", "must_contain": ["from mtg_policy.trigger_choices import", "PolicyStrategicChoiceProvider", "bind_policy_strategic_choices"]},
    {"name": "mandatory trigger targets cross the explicit policy boundary", "path": "src/mtg_kernel/phase_b_trigger_targets.py", "must_contain": ["_legal_candidates", "require_provider", "CardSelectionRequest", "TRIGGER_TARGET:", "selection.selected_handles", "by_handle", "strategic provider selected an illegal trigger target", "CARD_SELECTION"]},
    {"name": "trigger policy fails closed on unknown target effects", "path": "src/mtg_policy/trigger_choices.py", "must_contain": ["TRIGGER_TARGET:", "mandatory trigger target policy is unsupported for effect", "request.candidates"]},
    {"name": "counter-unless-pay choice crosses explicit policy and replay boundary", "path": "src/mtg_kernel/phase_b_runtime_effects_interaction.py", "must_contain": ["CounterPaymentRequest", "choose_counter_payment", "strategic provider selected an unavailable counter payment", "chosen_at\": \"RESOLUTION"]},
    {"name": "shared resolution card selection validates returned handles and count", "path": "src/mtg_kernel/phase_b_runtime_effects_selection.py", "must_contain": ["purpose=purpose", "not set(selected_handles) <= legal_handles", "not minimum <= len(selected_handles) <= maximum", "CARD_SELECTION"]},
    {"name": "prismari discard selection validates returned handles and count", "path": "src/mtg_kernel/phase_b_runtime_effects_prismari.py", "must_contain": ["purpose=\"PRISMARI_DISCARD\"", "not set(selected_handles) <= legal_handles", "len(selected_handles) != required", "CARD_SELECTION"]},
    {"name": "prismari cast uses two mode-owned target words", "path": "src/mtg_kernel/prismari_rules_conformance.py", "must_contain": ["Prismari Command requires exactly two distinct modes while casting", "prismari_targets", "prismari_target_modes", "zip(target_modes, selected_targets, strict=True)"]},
    {"name": "cleanup discard policy validates returned handles and records the command input", "path": "src/mtg_runs/phase_c_runner.py", "must_contain": ["purpose=\"DISCARD\"", "selection.selected_handles", "by_handle", "cleanup policy returned an illegal discard selection", "_cleanup_discard_ids(executor, provider)", "\"discard_ids\": list(discard_ids)"]},
    {"name": "production card selection policy selects only request candidates", "path": "src/mtg_policy/choices.py", "must_contain": ["request.candidates", "policy card-selection purpose is unsupported", "selected = tuple"]},
    {"name": "production specialized choices are constrained to legal request sets", "path": "src/mtg_policy/choices.py", "must_contain": ["request.eligible_cards", "request.legal_splits", "if selected not in request.legal_target_sets", "PAY_IF_CURRENT_POOL_CAN_PAY"]},
    {"name": "replay card selections recheck purpose candidate membership and count", "path": "src/mtg_kernel/strategic_choices.py", "must_contain": ["purpose != request.purpose", "not set(handles) <= legal", "not request.minimum <= len(handles) <= request.maximum"]},
    {"name": "replay specialized choices recheck legality", "path": "src/mtg_kernel/strategic_choices.py", "must_contain": ["identity not in request.eligible_identities", "split_index not in {split.split_index for split in request.legal_splits}", "handles not in request.legal_target_sets", "recorded counter payment is not legal from the replay mana pool"]},
    {"name": "replay uses recorded provider and requires exact transcript equality", "path": "src/mtg_kernel/replay.py", "must_contain": ["RecordedStrategicChoiceProvider(recorded_choices)", "replaying=True", "if actual != expected", "production replay diverged from the recorded transcript"]},
    {"name": "copy-target live path revalidates provider output", "path": "src/mtg_kernel/engine.py", "must_contain": ["selection.target_handles not in legal_handle_sets", "strategic provider selected an illegal copy target set", "self._validate_targets"]},
    {"name": "broker action choices are production-probed", "path": "src/mtg_policy/broker_core.py", "must_contain": ["def _target_sets", "def _probe", "self._invoke(probe", "PASS_PRIORITY", "_candidate_attack_declarations"]},
    {"name": "phase c chooses and executes broker actions through frozen policy", "path": "src/mtg_runs/phase_c_runner.py", "must_contain": ["policy.select_action", "broker.execute", "ActionBroker(executor, CONTROLLED_PLAYER)"]},
    {"name": "arcane denial delayed decision is explicit in the production runner", "path": "src/mtg_runs/phase_c_runner.py", "must_contain": ["arcane_denial_draw_count", "count = 2 if optional_player == CONTROLLED_PLAYER else 0", "delayed_trigger_choices"]}
  ]
