{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-sim.invalid/schemas/reference-scenario-v4.json",
  "title": "Frozen Phase A split-input reference scenario v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "scenario_version",
    "schema_version",
    "candidate_input",
    "referee_oracle"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_version": {
      "type": "integer",
      "minimum": 1
    },
    "schema_version": {
      "const": 4
    },
    "candidate_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number_of_players",
        "active_player",
        "priority_holder",
        "turn",
        "phase",
        "step",
        "life_totals",
        "card_instances",
        "objects",
        "initial_state",
        "library_constraints",
        "external_objects",
        "action_script",
        "legal_alternatives",
        "rng_streams"
      ],
      "properties": {
        "number_of_players": {},
        "active_player": {},
        "priority_holder": {},
        "turn": {},
        "phase": {},
        "step": {},
        "life_totals": {},
        "card_instances": {},
        "objects": {},
        "initial_state": {},
        "library_constraints": {},
        "external_objects": {},
        "action_script": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "script_index",
              "actor",
              "command"
            ],
            "properties": {
              "command": {
                "enum": [
                  "cast_spell",
                  "activate_ability",
                  "pass_priority",
                  "choose_target",
                  "choose_mode",
                  "choose_payment",
                  "declare_attacker",
                  "choose_optional_action",
                  "choose_commander_replacement",
                  "inject_external_spell",
                  "advance_step",
                  "play_land",
                  "take_game_action"
                ]
              }
            }
          }
        },
        "legal_alternatives": {},
        "rng_streams": {}
      }
    },
    "referee_oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "acceptance_requirement",
        "external_zone_ledger_expectations",
        "prerequisites",
        "expected_state_transition_predicates",
        "expected_final_state_predicates",
        "requirement_text",
        "forbidden_transitions",
        "required_call_contract",
        "semantic_assertion_plan"
      ],
      "properties": {
        "assertion_id": {},
        "acceptance_requirement": {},
        "external_zone_ledger_expectations": {},
        "prerequisites": {},
        "expected_state_transition_predicates": {},
        "expected_final_state_predicates": {},
        "requirement_text": {},
        "forbidden_transitions": {},
        "required_call_contract": {},
        "semantic_assertion_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ordered_event_types",
            "require_registered_object_references",
            "require_non_noop_transitions",
            "require_causal_parent_order"
          ],
          "properties": {
            "ordered_event_types": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "require_registered_object_references": {
              "const": true
            },
            "require_non_noop_transitions": {
              "const": true
            },
            "require_causal_parent_order": {
              "const": true
            }
          }
        }
      }
    }
  }
}
