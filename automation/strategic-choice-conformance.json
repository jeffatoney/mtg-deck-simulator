    {"timing": "CAST_PROPOSAL", "purpose": "TARGET_SELECTION", "mechanism": "BROKER_ACTION"},
    {"timing": "CAST_PROPOSAL", "purpose": "X_VALUE", "mechanism": "BROKER_ACTION"},
    {"timing": "ACTIVATION_PROPOSAL", "purpose": "TARGET_COUNT", "mechanism": "BROKER_ACTION"},
    {"timing": "ACTIVATION_PROPOSAL", "purpose": "TARGET_SELECTION", "mechanism": "BROKER_ACTION"},
    {"timing": "TRIGGER_STACKING", "purpose": "TARGET_SELECTION", "mechanism": "INJECTED_CARD_SELECTION", "runtime_purpose": "TRIGGER_TARGET:*"},
    {"timing": "RESOLUTION", "purpose": "COPY_NEW_TARGETS", "mechanism": "PROTOCOL_METHOD", "protocol_method": "choose_spell_copy_targets"},
    {"timing": "RESOLUTION", "purpose": "FACT_OR_FICTION_SPLIT", "mechanism": "PROTOCOL_METHOD", "protocol_method": "choose_fact_or_fiction"},
    {"timing": "RESOLUTION", "purpose": "FACT_OR_FICTION_PILE", "mechanism": "PROTOCOL_METHOD", "protocol_method": "choose_fact_or_fiction"},
    {"timing": "RESOLUTION", "purpose": "SEARCH_SELECTION_OR_FAIL_TO_FIND_STATED_QUALITY", "mechanism": "INJECTED_CARD_SELECTION", "runtime_purpose": "TUTOR_*"},
    {"timing": "RESOLUTION", "purpose": "SEARCH_SELECTION_REQUIRED_IF_LIBRARY_NONEMPTY", "mechanism": "INJECTED_CARD_SELECTION", "runtime_purpose": "TUTOR_*"},
