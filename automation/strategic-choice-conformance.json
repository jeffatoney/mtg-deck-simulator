{
  "schema_version": "strategic-choice-conformance-v1",
  "purpose": "Fail-closed routing contract from rules-defined strategic choices to production policy, legality validation, and exact replay.",
  "runtime_purpose_contracts": [
    {"runtime_purpose": "DISCARD", "policy_provider": "PolicyStrategicChoiceProvider.choose_cards", "replay_mode": "RECORDED_COMMAND_ARGUMENT"},
    {"runtime_purpose": "UNTAP_LANDS", "policy_provider": "PolicyStrategicChoiceProvider.choose_cards", "replay_mode": "RECORDED_STRATEGIC_CHOICE"},
    {"runtime_purpose": "LOOK_SELECT", "policy_provider": "PolicyStrategicChoiceProvider.choose_cards", "replay_mode": "RECORDED_STRATEGIC_CHOICE"},
    {"runtime_purpose": "ORDER_LIBRARY_BOTTOM", "policy_provider": "PolicyStrategicChoiceProvider.choose_cards", "replay_mode": "RECORDED_STRATEGIC_CHOICE"},
    {"runtime_purpose": "TUTOR_*", "policy_provider": "PolicyStrategicChoiceProvider.choose_cards", "replay_mode": "RECORDED_STRATEGIC_CHOICE"},
    {"runtime_purpose": "TRIGGER_TARGET:*", "policy_provider": "PolicyStrategicChoiceProvider.choose_cards", "replay_mode": "RECORDED_STRATEGIC_CHOICE"}
  ],
  "canonical_routes": [
    {"timing": "CAST_PROPOSAL", "purpose": "CAST_PATH", "mechanism": "BROKER_ACTION"},
