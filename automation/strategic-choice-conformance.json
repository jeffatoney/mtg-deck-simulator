    {"timing": "RESOLUTION", "purpose": "DRAW_DISCARD_SELECTION_IF_CHOSEN", "mechanism": "INJECTED_CARD_SELECTION", "runtime_purpose": "DISCARD"},
    {"timing": "RESOLUTION", "purpose": "UNTAP_LAND_SELECTION", "mechanism": "INJECTED_CARD_SELECTION", "runtime_purpose": "UNTAP_LANDS"},
    {"timing": "RESOLUTION", "purpose": "LOOK_CARD_SELECTION", "mechanism": "INJECTED_CARD_SELECTION", "runtime_purpose": "LOOK_SELECT"},
