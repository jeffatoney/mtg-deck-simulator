{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mtg-sim.invalid/schemas/golden-replay-v2.json",
  "title": "Phase A Golden Transcript v2",
  "type": "object",
  "required": ["schema_version", "scenario_id", "scenario_version", "review_status", "review_evidence", "initial_state", "actions", "expected_transitions", "rng_streams", "external_ledger", "expected_final_predicates"],
  "properties": {
    "schema_version": {"const": 2},
    "scenario_id": {"type": "string", "minLength": 1},
    "scenario_version": {"type": "integer", "minimum": 1},
    "review_status": {"enum": ["draft-unreviewed", "rules-reviewed", "independently-reviewed"]},
    "review_evidence": {"type": ["object", "null"]},
    "initial_state": {"type": "object"},
    "actions": {"type": "array", "minItems": 1},
    "expected_transitions": {"type": "array", "minItems": 1},
    "rng_streams": {"type": "object", "minProperties": 1},
    "external_ledger": {"type": "array"},
    "expected_final_predicates": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false,
  "allOf": [{"if": {"properties": {"review_status": {"const": "independently-reviewed"}}}, "then": {"properties": {"review_evidence": {"type": "object"}}, "required": ["review_evidence"]}}]
}
