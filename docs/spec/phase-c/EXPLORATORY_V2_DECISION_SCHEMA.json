{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase-c-exploratory-v2-decision-schema-v1",
  "title": "Phase C Exploratory V2 Decision Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "arm_id",
    "game_index",
    "environment_seed",
    "exploration_seed",
    "decision_id",
    "turn",
    "phase",
    "public_observation_digest",
    "strategic_choice_purpose",
    "legal_candidate_handles",
    "standard_baseline_handle",
    "standard_baseline_score_vector",
    "candidate_evaluations",
    "pruned_candidates",
    "arm_specific_exclusions",
    "novelty_state_before",
    "equivalence_window",
    "eligible_top_k",
    "selected_action",
    "selection_reason",
    "randomness_affected_selection",
    "selected_plan_or_package_id",
    "continuation_method",
    "continuation_horizon",
    "plan_termination_or_fallback_reason",
    "resulting_public_state_digest",
    "replay_binding"
  ],
  "properties": {
    "schema_version": {"const": "phase-c-exploratory-v2-decision-v1"},
    "arm_id": {"enum": ["EXPLORATORY_AGGRESSIVE_V2", "EXPLORATORY_ALT_PACKAGE_NO_GLINT_TUTOR_V2", "EXPLORATORY_INTERACTION_DISCOVERY_V2"]},
    "game_index": {"type": "integer", "minimum": 1},
    "environment_seed": {"type": "integer"},
    "exploration_seed": {"type": "integer"},
    "decision_id": {"type": "string", "minLength": 1},
    "turn": {"type": "integer", "minimum": 1},
    "phase": {"type": "string", "minLength": 1},
    "public_observation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strategic_choice_purpose": {"type": "string", "minLength": 1},
    "legal_candidate_handles": {"type": "array", "items": {"type": "string"}},
    "standard_baseline_handle": {"type": "string"},
    "standard_baseline_score_vector": {"$ref": "#/$defs/scoreVector"},
    "candidate_evaluations": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "pruned_candidates": {"type": "array", "items": {"type": "object"}},
    "arm_specific_exclusions": {"type": "array", "items": {"type": "object"}},
    "novelty_state_before": {"type": "object"},
    "equivalence_window": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "eligible_top_k": {"type": "array", "items": {"type": "string"}},
    "selected_action": {"type": "string"},
    "selection_reason": {"type": "string"},
    "randomness_affected_selection": {"type": "boolean"},
    "selected_plan_or_package_id": {"type": ["string", "null"]},
    "continuation_method": {"type": "string"},
    "continuation_horizon": {"type": "object"},
    "plan_termination_or_fallback_reason": {"type": ["string", "null"]},
    "resulting_public_state_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "replay_binding": {"type": "object"}
  },
  "$defs": {
    "scoreVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediate_deterministic_access", "projected_deterministic_access", "earliest_projected_access_turn", "known_package_progress", "mana_development_value", "relevant_resource_preservation", "card_selection_or_tutor_value", "conditional_access_status", "novelty_value", "arm_constraint_status", "action_cost", "reason_codes", "final_candidate_rank"],
      "properties": {
        "immediate_deterministic_access": {"type": "boolean"},
        "projected_deterministic_access": {"type": "boolean"},
        "earliest_projected_access_turn": {"type": ["integer", "null"], "minimum": 1},
        "known_package_progress": {"type": "integer", "minimum": 0},
        "mana_development_value": {"type": "integer", "minimum": 0},
        "relevant_resource_preservation": {"type": "integer", "minimum": 0},
        "card_selection_or_tutor_value": {"type": "integer", "minimum": 0},
        "conditional_access_status": {"enum": ["NONE", "PROGRESS", "AVAILABLE"]},
        "novelty_value": {"type": "integer", "minimum": 0},
        "arm_constraint_status": {"type": "string"},
        "action_cost": {"type": "integer", "minimum": 0},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "final_candidate_rank": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "candidate": {
      "type": "object",
      "required": ["handle", "semantic_key", "score", "pruned_reason"],
      "properties": {
        "handle": {"type": "string"},
        "semantic_key": {"type": "string"},
        "score": {"$ref": "#/$defs/scoreVector"},
        "pruned_reason": {"type": ["string", "null"]}
      }
    }
  }
}
