+    OpeningHandRecord,
+    _GameMeasurementCapture,
+    _auto_pass_opponents_until_control,
+    _bound_policy,
+    _build_game_measurement,
+    _cleanup_discard_ids,
+    _combat_optional_trigger_choices,
+    _combo_evaluation,
+    _delayed_trigger_step_choices,
+    _finalize_refill_names,
